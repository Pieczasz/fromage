{
  "mcpServers": {
    "fromage": {
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "COMPOSE_FILE",
        "run",
        "--rm",
        "-T",
        "--no-deps",
        "-e",
        "MCP_TRANSPORT=stdio",
        "-e",
        "FROMAGE_SEARXNG_URL=http://searxng:8080",
        "-e",
        "OLLAMA_HOST=http://ollama:11434",
        "--entrypoint",
        "python",
        "mcp",
        "-m",
        "fromage.mcp_server"
      ]
    }
  }
}
